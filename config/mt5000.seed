# Target: GL.iNet MT5000 (Brume 3) / MediaTek MT7987A filogic
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_glinet_gl-mt5000=y

# Rootfs size (8GB eMMC, leave headroom for extra packages)
CONFIG_TARGET_ROOTFS_PARTSIZE=2048

# Default LAN IP 192.168.5.1 (official base-files mechanism, also covers failsafe/preinit)
CONFIG_IMAGEOPT=y
CONFIG_TARGET_DEFAULT_LAN_IP_FROM_PREINIT=y
CONFIG_PREINITOPT=y
CONFIG_TARGET_PREINIT_IP="192.168.5.1"
CONFIG_TARGET_PREINIT_NETMASK="255.255.255.0"
CONFIG_TARGET_PREINIT_BROADCAST="192.168.5.255"

# ============================================================================
# 25.12 filogic 默认包集补齐（关键区段，勿删）
# ----------------------------------------------------------------------------
# master 的 include/target.mk 把「追加 tweak 默认包集」那行注释掉了：
#     # DEFAULT_PACKAGES += $(DEFAULT_PACKAGES.tweak)
# 而 25.12 是启用的：
#     DEFAULT_PACKAGES += $(DEFAULT_PACKAGES.tweak)
# 25.12 的 tweak 内容为：
#     block-mount  default-settings-chn  kmod-nf-nathelper  luci
# 所以 master 基线编出来的固件会完全没有 LuCI，刷完只能 ssh，无法 web 管理。
# 下面四项即是对 25.12 tweak 段的手工等价补齐。
# ============================================================================
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_default-settings-chn=y
CONFIG_PACKAGE_kmod-nf-nathelper=y

# --- 基础增强（官方默认集之外的少量工具）---
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ip-full=y

# autocore: 状态页显示 CPU 型号 / 频率 / 温度（ImmortalWrt 特有）
CONFIG_PACKAGE_autocore=y

# LuCI 简体中文界面（default-settings-chn 依赖此符号，中文 i18n 必装；
# 默认界面语言由首启脚本 99-luci-lang 写 luci.main.lang=zh_cn）
CONFIG_LUCI_LANG_zh_Hans=y

# --- GL-MT5000 hardware is wired-only (no Wi-Fi radio) ---
# The stock target pulls in wpad + hostapd + wpa_supplicant, which all fail
# to start on this board ("ubus: Unable to resolve path for module 'common'")
# and waste ~18 MB of the 1 GiB RAM. Keep the DSA/ethernet stack, drop the
# whole wireless supplicant package set.
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
# CONFIG_PACKAGE_wpad-openssl is not set
# CONFIG_PACKAGE_wpad-basic-wolfssl is not set
# CONFIG_PACKAGE_hostapd-common is not set
# CONFIG_PACKAGE_wpa-supplicant is not set

# UPnP/IGD is enabled by default in the profile; this box is used as a plain
# gateway and auto-opening inbound pinholes is an unnecessary attack surface.
# Turn it on deliberately (LuCI -> Services -> UPnP) if console/game/NAT-PMP
# traversal is actually needed.
# CONFIG_PACKAGE_miniupnpd is not set
# CONFIG_PACKAGE_luci-app-upnp is not set

# --- 内核调试：dynamic debug -------------------------------------------
# 把 pr_debug() / dev_dbg() 编进内核，运行时可按「源文件 / 函数 / 行号 /
# 模块」动态开关（/sys/kernel/debug/dynamic_debug/control），无需重编内核。
# 代价：内核 text 约 +2%（几 MB 以内），运行时无额外开销（默认全关）。
#
# 用法：
#   已挂载 debugfs（/etc/init.d/boot 会自动挂 /sys/kernel/debug）
#   echo 'file mtk_eth_soc.c +p' > /sys/kernel/debug/dynamic_debug/control
#   dmesg -w | grep -i mtk
#   全部关掉：echo 'file * -p' > .../control
#
# 正式版想去掉这段调试能力时，删掉这行即可（不影响其他功能）。
CONFIG_KERNEL_DYNAMIC_DEBUG=y
# DYNAMIC_DEBUG 依赖 debugfs；OpenWrt 默认已开（default y），显式写出防止被改
CONFIG_KERNEL_DEBUG_FS=y

# --- Build-time: ccache ------------------------------------------------
# 让编译器把 C/C++ 目标文件缓存到 .ccache，配合 workflow 里对
# staging_dir + .ccache 的缓存，增量构建能省掉绝大部分重复编译。
# 只影响构建速度，不改变产物内容。
CONFIG_CCACHE=y
