# GL.iNet MT5000 (Brume 3) / MediaTek MT7987A filogic
# 基线：immortalwrt master 分支（4765b65762，内核 6.18.60）
#
# 范围约束：除下面的目标选择外，本文件只允许出现
#   「immortalwrt 25.12 常规正式版分支相对 immortalwrt master 分支默认多出的包」。
# 不附加任何其它包、首启脚本或定制配置；不覆盖任何平台默认包。
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_glinet_gl-mt5000=y

# ---------------------------------------------------------------------------
# 25.12 默认包集相对 master 的差集（唯一允许的包添加）
# ---------------------------------------------------------------------------
# 来源 1 — include/target.mk
#   25.12: DEFAULT_PACKAGES += $(DEFAULT_PACKAGES.tweak)   （启用）
#   master: # DEFAULT_PACKAGES += $(DEFAULT_PACKAGES.tweak) （注释掉）
#   25.12 的 tweak 段内容为以下 4 个包：
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_default-settings-chn=y
CONFIG_PACKAGE_kmod-nf-nathelper=y
CONFIG_PACKAGE_luci=y

# 来源 2 — target/linux/mediatek/Makefile
#   25.12: DEFAULT_PACKAGES += kmod-leds-gpio kmod-gpio-button-hotplug autocore
#   master: DEFAULT_PACKAGES += kmod-leds-gpio kmod-gpio-button-hotplug
#   差集：autocore
CONFIG_PACKAGE_autocore=y

# 来源 3 — target/linux/mediatek/filogic/target.mk
#   25.12: DEFAULT_PACKAGES += fitblk kmod-crypto-hw-safexcel wpad-openssl uboot-envtools bridger
#   master: DEFAULT_PACKAGES += fitblk wpad-openssl uboot-envtools bridger
#   差集：kmod-crypto-hw-safexcel
CONFIG_PACKAGE_kmod-crypto-hw-safexcel=y

# ---------------------------------------------------------------------------
# 说明
# ---------------------------------------------------------------------------
# * default-settings-chn 的 DEPENDS 含 +@LUCI_LANG_zh_Hans +luci-i18n-base-zh-cn，
#   中文 i18n 由依赖自动带入，无需另写配置符号。
# * LAN IP / 主机名 / 时区 / root 密码 / 界面语言 / PPPoE / IPv6 全部沿用
#   master 官方默认值，本 seed 不做任何定制（含 CONFIG_TARGET_PREINIT_*）。
# * 无任何 "is not set" 覆盖：master 的平台默认包（wpad / bridger / ppp 等）
#   原样保留，不做减法。
# * 无内核调试、分区尺寸、ccache 等构建期或运行期定制项。
