+From eafa7cb1c902858b6e4cfb2b92d837458b4e935e Mon Sep 17 00:00:00 2001
+From: Hongjian Zhang <hongjian.zhang@gl-inet.com>
+Date: Thu, 5 Nov 2026 15:34:44 +0800
+Subject: [PATCH] net: mediatek: limit special-tag handling to the native MTK
+ tagger
+
+The MediaTek DMA special-tag bits describe the native MTK DSA header.
+Other DSA protocols, including Realtek and MxL8021Q, carry a different
+header or an ordinary VLAN tag and must not enable this parser/inserter.
+
+Use the existing mtk_uses_dsa() check for TX_DMA_SPTAG_V3 and GDMA special
+tag handling. Clear the GDMA bit before selecting the current mode so a
+previous native-tag configuration cannot persist for another tagger.
+
+This also changes non-MTK-tagged MediaTek systems such as MT7622/MT7981
+with RTL8365MB and MT7988 with MxL86282; their frames are no longer
+interpreted as native MTK tags. Native MTK DSA keeps its existing mode.
+
+Declare the shared helper before its first TX-path call; its definition
+remains below the GDMA setup.
+
+Signed-off-by: Hongjian Zhang <hongjian.zhang@gl-inet.com>
+---
+ drivers/net/ethernet/mediatek/mtk_eth_soc.c | 8 +++++---
+ 1 file changed, 5 insertions(+), 3 deletions(-)
+
+--- a/drivers/net/ethernet/mediatek/mtk_eth_soc.c
++++ b/drivers/net/ethernet/mediatek/mtk_eth_soc.c
+@@ -38,6 +38,8 @@
+ #include "mtk_eth_soc.h"
+ #include "mtk_wed.h"
+ 
++static bool mtk_uses_dsa(struct net_device *dev);
++
+ static int mtk_msg_level = -1;
+ module_param_named(msg_level, mtk_msg_level, int, 0);
+ MODULE_PARM_DESC(msg_level, "Message level (-1=defaults,0=none,...,16=all)");
+@@ -1582,7 +1584,7 @@ static void mtk_tx_set_dma_desc_v2(struc
+ 		/* tx checksum offload */
+ 		if (info->csum)
+ 			data |= TX_DMA_CHKSUM_V2;
+-		if (mtk_is_netsys_v3_or_greater(eth) && netdev_uses_dsa(dev))
++		if (mtk_is_netsys_v3_or_greater(eth) && mtk_uses_dsa(dev))
+ 			data |= TX_DMA_SPTAG_V3;
+ 	}
+ 	WRITE_ONCE(desc->txd5, data);
+@@ -3749,14 +3751,14 @@ static void mtk_gdm_config(struct mtk_et
+ 	val = mtk_r32(eth, MTK_GDMA_FWD_CFG(id));
+ 
+ 	/* default setup the forward port to send frame to PDMA */
+-	val &= ~0xffff;
++	val &= ~(0xffff | MTK_GDMA_SPECIAL_TAG);
+ 
+ 	/* Enable RX checksum */
+ 	val |= MTK_GDMA_ICS_EN | MTK_GDMA_TCS_EN | MTK_GDMA_UCS_EN;
+ 
+ 	val |= config;
+ 
+-	if (eth->netdev[id] && netdev_uses_dsa(eth->netdev[id]))
++	if (eth->netdev[id] && mtk_uses_dsa(eth->netdev[id]))
+ 		val |= MTK_GDMA_SPECIAL_TAG;
+ 
+ 	mtk_w32(eth, val, MTK_GDMA_FWD_CFG(id));
